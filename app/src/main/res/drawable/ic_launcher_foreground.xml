<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer Ambient Glow Ring in Neon Amber -->
    <path
        android:pathData="M54,26 C69.46,26 82,38.54 82,54 C82,69.46 69.46,82 54,82 C38.54,82 26,69.46 26,54 C26,38.54 38.54,26 54,26 Z"
        android:strokeColor="#25FF6600"
        android:strokeWidth="1.5" />

    <!-- Left Code Bracket < in Neon Orange -->
    <path
        android:pathData="M34,44 L28,53 L34,62"
        android:strokeColor="#FF6600"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Right Code Bracket > in Neon Orange -->
    <path
        android:pathData="M74,44 L80,53 L74,62"
        android:strokeColor="#FFAA00"
        android:strokeWidth="2.8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Stylized Raven Silhouette forming Letter "R" (Stem, Loop, Beak, Leg) -->
    <!-- 1. Vertical Spine of "R" (Raven Wing Quill) -->
    <path
        android:pathData="M39,32 L46,32 L46,74 L39,74 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="39"
                android:startY="32"
                android:endX="46"
                android:endY="74"
                android:type="linear">
                <item android:color="#FFAA00" android:offset="0.0" />
                <item android:color="#FF6600" android:offset="0.5" />
                <item android:color="#FF3300" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 2. Raven Head & Beak + "R" Top Loop -->
    <path
        android:pathData="M46,32 L62,32 C68,32 72,36 72,42 C72,48 68,52 62,52 L46,52 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="46"
                android:startY="32"
                android:endX="72"
                android:endY="52"
                android:type="linear">
                <item android:color="#FFCC00" android:offset="0.0" />
                <item android:color="#FF6600" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Cutout of "R" Loop -->
    <path
        android:pathData="M46,38 L59,38 C62,38 64,40 64,42 C64,44 62,46 59,46 L46,46 Z"
        android:fillColor="#18181B" />

    <!-- 3. Raven Beak (pointing right/forward) -->
    <path
        android:pathData="M72,37 L79,42 L72,45 Z"
        android:fillColor="#FFD166" />

    <!-- 4. Raven Eye Accent -->
    <path
        android:pathData="M66,39 A1.5,1.5 0 1,0 66,42 A1.5,1.5 0 1,0 66,39 Z"
        android:fillColor="#FFFFFF" />

    <!-- 5. "R" Dynamic Diagonal Kick / Raven Tail Feathers -->
    <path
        android:pathData="M52,50 L68,74 L60,74 L46,53 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="46"
                android:startY="50"
                android:endX="68"
                android:endY="74"
                android:type="linear">
                <item android:color="#FF6600" android:offset="0.0" />
                <item android:color="#FF3300" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 6. Feather Slit Accents in the wing -->
    <path
        android:pathData="M40,44 L45,47 M40,54 L45,57 M40,64 L45,67"
        android:strokeColor="#18181B"
        android:strokeWidth="1.2"
        android:strokeLineCap="round" />

</vector>
