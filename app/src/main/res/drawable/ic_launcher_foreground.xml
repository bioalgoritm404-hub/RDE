<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Glowing backdrop hexagon/ring -->
    <path
        android:pathData="M54,26 L76,38 L76,68 L54,80 L32,68 L32,38 Z"
        android:strokeColor="#2500E5FF"
        android:strokeWidth="2.5"
        android:fillColor="#15007ACC" />

    <!-- Left Code Bracket < -->
    <path
        android:pathData="M39,42 L29,53 L39,64"
        android:strokeColor="#00E5FF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Right Code Bracket > -->
    <path
        android:pathData="M69,42 L79,53 L69,64"
        android:strokeColor="#00E5FF"
        android:strokeWidth="3.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Raven Geometric Silhouette / Head & Beak & Wings -->
    <path
        android:pathData="M54,32 L60,40 L68,43 L60,49 L62,59 L54,54 L46,59 L48,49 L40,43 L48,40 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="40"
                android:startY="32"
                android:endX="68"
                android:endY="59"
                android:type="linear">
                <item android:color="#00E5FF" android:offset="0.0" />
                <item android:color="#007ACC" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Beak accent -->
    <path
        android:pathData="M54,34 L56,41 L52,41 Z"
        android:fillColor="#FFFFFF" />

    <!-- Python prompt slash & cursor -->
    <path
        android:pathData="M51,68 L57,60"
        android:strokeColor="#FFD166"
        android:strokeWidth="2.5"
        android:strokeLineCap="round" />

    <!-- Underscore cursor -->
    <path
        android:pathData="M58,68 L64,68"
        android:strokeColor="#00E5FF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round" />

</vector>
